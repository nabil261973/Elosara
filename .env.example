# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: Direct PostgreSQL connection string (for Neon / Vercel Postgres deployment)
# Example: postgresql://neondb_owner:password@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=""

# Google Cloud SQL PostgreSQL configuration (automatically provisioned in AI Studio / Cloud Run)
INSTANCE_CONNECTION_NAME="seraphic-domain-l83d0:europe-west3:ai-studio-60c80c86"
DB_USER="ai_studio_admin"
DB_NAME="cloud_sql_development_database"
